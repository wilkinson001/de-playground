# Copy to .env (git-ignored). Local-only defaults; nothing here is exposed beyond your machine.

# Postgres 18 (shared by DuckLake, Lakekeeper, DBOS, Prefect, Dagster)
POSTGRES_USER=playground
POSTGRES_PASSWORD=playground

# SeaweedFS S3 gateway credentials
S3_ACCESS_KEY=playground
S3_SECRET_KEY=playground-secret

# Lakekeeper encrypts stored secrets with this key
LAKEKEEPER_ENCRYPTION_KEY=change-me-32-chars-minimum-000000

# AI phase (unused until then)
NVIDIA_API_KEY=
